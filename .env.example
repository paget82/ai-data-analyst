# Copy this file to .env and fill in the values before running
# `docker compose up -d --build`.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Local Postgres database (replaces Supabase — runs entirely in Docker)
# ---------------------------------------------------------------------------
POSTGRES_USER=analyst
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist

# pgAdmin (web UI for the database, http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Backend (Python agent service — replaces n8n)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret checked on every request via the X-API-Key header.
# Generate a random one, e.g.: openssl rand -hex 24
API_AUTH_TOKEN=change-me-to-a-long-random-secret

# Host port the backend is published on (container always listens on 8000).
BACKEND_PORT=5679

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Baked into the frontend's compiled JS bundle at build time (see
# frontend/Dockerfile), so it knows where to send chat requests and which
# API key to send. Must match BACKEND_PORT / API_AUTH_TOKEN above.
VITE_API_URL=http://localhost:5679/webhook/data-analyst-agent

# Timezone used inside the backend container.
TZ=Europe/Prague
