# Copy this file to .env and fill in the values before running
# `docker compose up -d --build`.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Local Postgres database (replaces Supabase — runs entirely in Docker)
# ---------------------------------------------------------------------------
POSTGRES_USER=analyst
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist

# pgAdmin (web UI for the database, http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# n8n / frontend
# ---------------------------------------------------------------------------
# These two are baked into the frontend's compiled JS bundle at build time
# (see frontend/Dockerfile), so the frontend container knows where to send
# chat requests. They must match the webhook you publish in n8n — see the
# "n8n workflows" section of the README.

# Production webhook URL of the "main-flow" workflow, once activated in n8n.
VITE_N8N_WEBHOOK_URL=http://localhost:5679/webhook/data-analyst-agent

# Must match the value of the "Header Auth account" credential you create
# in n8n for the Webhook node (sent as the X-API-Key header on every request).
# Generate a random one, e.g.: openssl rand -hex 24
VITE_N8N_AUTH_TOKEN=change-me-to-a-long-random-secret

# Timezone used inside the n8n container.
TZ=Europe/Prague
